# Web build must be same-origin (nginx or the vite /api proxy): the HttpOnly
# refresh cookie (mvs_refresh) does not survive a cross-origin API base, so
# /auth/refresh would always 401 and the user would be logged out on token
# expiry. In dev, Vite proxies /api to VITE_API_PROXY_TARGET (localhost:8080).
VITE_API_URL=/api/v1